# ============================================================
# AImaginator — .env.development.example
# Copie para .env.development e ajuste se necessario.
# Este arquivo e para desenvolvimento local. O .env da raiz esta em
# modo production e NAO deve ser usado para subir a stack local.
# ============================================================

# ---- Core ----
FEATURE_IMAGE_GENERATION_ENABLED=true
APP_ENV=development
APP_NAME=AImaginator
# Dev-only. Gere um valor proprio se quiser:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-key-change-before-sharing-000000000000
API_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:3000
# Origens extras de CORS separadas por virgula. FRONTEND_BASE_URL e sempre incluida.
# Em dev o Next usa 3000; se estiver ocupada (ex.: Grafana do host), cai para 3001.
# Inclua localhost e 127.0.0.1 na porta efetiva do frontend.
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
AUTO_MIGRATE=true

# ---- PostgreSQL (host 5433 para nao conflitar com ForjaB2B) ----
POSTGRES_USER=aimaginator
POSTGRES_PASSWORD=aimaginator_dev
POSTGRES_DB=aimaginator
DATABASE_URL=postgresql+asyncpg://aimaginator:aimaginator_dev@localhost:5433/aimaginator

# ---- Redis (host 6380) ----
REDIS_URL=redis://localhost:6380/0

# ---- RabbitMQ / Celery (host 5673/15673) ----
RABBITMQ_URL=amqp://guest:guest@localhost:5673//
CELERY_BROKER_URL=amqp://guest:guest@localhost:5673//
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# ---- Google OAuth (opcional em dev) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ---- JWT ----
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# ---- Engine de imagem (stub para dev sem modelo; sdcpp para FLUX/Kontext) ----
IMAGE_ENGINE=stub
SDCPP_BINARY_PATH=
SDCPP_VAE_PATH=
SDCPP_CLIP_L_PATH=
SDCPP_T5XXL_PATH=
SDCPP_GEN_MODEL_PATH=
SDCPP_EDIT_MODEL_PATH=
AI_IMAGE_PROVIDER=stub
AI_IMAGE_API_KEY=
AI_IMAGE_API_BASE_URL=

# ---- Parametros de geracao/edicao (medidos no spike) ----
GEN_WIDTH=512
GEN_HEIGHT=512
GEN_STEPS=8
GEN_GUIDANCE=3.5
EDIT_WIDTH=512
EDIT_HEIGHT=512
EDIT_STEPS=8
EDIT_GUIDANCE=3.5
GENERATION_TIMEOUT_SECONDS=300
EDIT_TIMEOUT_SECONDS=600
MIN_FREE_RAM_MB=6000
COOLDOWN_SECONDS_BETWEEN_JOBS=0

# ---- Upload de edicao ----
EDIT_UPLOAD_MAX_BYTES=10485760
EDIT_UPLOAD_MAX_DIMENSION=8192
EDIT_UPLOAD_MAX_PIXELS=40000000

# ---- Assistente de prompts (LM Studio local) ----
PROMPT_MAX_CHARS=1000
LLM_BASE_URL=http://localhost:1235/v1
# Recomendado: 4B Q4_K_M (cabe melhor na VRAM e responde mais rapido).
# LLM_MODEL=qwen3.5-4b@q4_k_m
# Alternativa mais lenta/pesada:
# LLM_MODEL=qwen/qwen3.5-9b
LLM_API_KEY=lm-studio
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=512
LLM_MAX_OUTPUT_TOKENS_RETRY=1024
# "none" desliga o reasoning; vazio = nao envia o campo.
LLM_REASONING_EFFORT=none
LLM_TTL_SECONDS=60
# Descarrega o modelo via `lms unload --all` antes do FLUX.
LLM_UNLOAD_AFTER_USE=true
# Vazio = tenta "lms" do PATH. Ex.: C:\Program Files\LM Studio\lms.exe
LMS_CLI_PATH=
LLM_UNLOAD_TIMEOUT_SECONDS=20
# Conteudo do LLM em log SO em development e com opt-in; nunca em producao.
LLM_DEBUG_LOG_CONTENT=false
LLM_BLOCK_CONFIDENCE=0.5

# ---- Fila / reconciliacao ----
QUEUE_STALE_SECONDS=900
# Em development, infra remota falha o boot salvo opt-in consciente.
ALLOW_REMOTE_INFRA_IN_DEV=false

# ---- Moderacao e penalidades ----
MODERATION_STORE_PROMPT_TEXT=false
MOD_WARN_AT=3
MOD_BLOCK_AT=5
MOD_BLOCK_MINUTES=60
MOD_REVIEW_AT=10
MOD_REVIEW_BLOCK_HOURS=24
MODERATION_WINDOW_HOURS=24

# ---- Classificador de topico (stub em dev) ----
TOPIC_CLASSIFIER_PROVIDER=stub
TOPIC_CLASSIFIER_API_KEY=
TOPIC_CLASSIFIER_API_BASE_URL=
TOPIC_CLASSIFIER_MODEL=gemini-1.5-flash
TOPIC_CLASSIFIER_TIMEOUT_SECONDS=4.0

# ---- Observabilidade ----
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
SENTRY_ENVIRONMENT=development
PROMETHEUS_MULTIPROC_DIR=.prometheus-multiproc
WORKER_METRICS_PORT=9100

# ---- Rate limiting / resiliencia ----
RATE_LIMIT_GENERATION_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ---- SSRF ----
ALLOWED_IMAGE_URL_DOMAINS=images.unsplash.com

# ---- Storage (MinIO local; portas 9002/9003 do compose) ----
STORAGE_BUCKET_URL=http://localhost:9002/aimaginator-dev
MINIO_ROOT_USER=aimaginator
MINIO_ROOT_PASSWORD=aimaginator_dev_minio
S3_ENDPOINT_URL=http://localhost:9002
S3_PUBLIC_ENDPOINT_URL=http://localhost:9002
S3_BUCKET=aimaginator-dev
S3_ACCESS_KEY=aimaginator
S3_SECRET_KEY=aimaginator_dev_minio
S3_REGION=us-east-1
S3_PRESIGN_EXPIRES_SECONDS=900
S3_SOURCE_RETENTION_HOURS=24

# ---- Grafana dev ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev

# ---- Frontend (publico; configure tambem apps/web/.env.local) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Em desenvolvimento nao exigir login para gerar/baixar; producao usa o padrao (true).
NEXT_PUBLIC_REQUIRE_LOGIN_TO_SAVE=false
NEXT_PUBLIC_SENTRY_DSN=

# ---- Moderacao de imagem (saida e origem de edicao) ----
IMAGE_MODERATION_ENABLED=true
# fake (testes/dev) | local (transformers/CLIP; grupo opcional "moderation")
IMAGE_MODERATOR=fake
IMAGE_NSFW_MODEL_PATH=
IMAGE_CLIP_MODEL_PATH=
IMAGE_NSFW_THRESHOLD=0.5
IMAGE_GORE_THRESHOLD=0.5
IMAGE_HATE_THRESHOLD=0.5
IMAGE_SELF_HARM_THRESHOLD=0.5

# ---- Marca d'agua (aplicada em TODAS as imagens servidas) ----
WATERMARK_LOGO_PATH=modules/image_generation/assets/AImaginator_pic_transparent.png
WATERMARK_WIDTH_RATIO=0.20
WATERMARK_MIN_WIDTH_PX=96
WATERMARK_MARGIN_RATIO=0.025
WATERMARK_OPACITY=0.9
WATERMARK_SHADOW=true

# ---- Metadados de IA / C2PA opcional ----
C2PA_ENABLED=false
C2PA_CERT_PATH=
C2PA_KEY_PATH=

# ---- Upscale ----
UPSCALE_ENGINE=lanczos
SDCPP_UPSCALE_MODEL_PATH=
UPSCALE_TIMEOUT_SECONDS=300
UPSCALE_DAILY_LIMIT=5

# Origem publica do storage para CSP do frontend
NEXT_PUBLIC_STORAGE_ORIGIN=http://localhost:9002

# ---- Plataforma (Fase 9) ----
WORKER_MODE=local
WORKER_CAPABILITIES=generate,edit,upscale
WORKER_HEARTBEAT_TTL_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
# Vazio = automatico (true para sdcpp/hosted, false para stub)
ENGINE_AVAILABILITY_REQUIRED=
MAINTENANCE_MODE=false
MAINTENANCE_REDIS_KEY=system:maintenance
IMAGE_ENGINE_FALLBACK=

HOSTED_ENGINE_BASE_URL=
HOSTED_ENGINE_API_KEY=
HOSTED_ENGINE_GENERATE_PATH=/generate
HOSTED_ENGINE_EDIT_PATH=/edit
HOSTED_ENGINE_POLL_INTERVAL_SECONDS=1
HOSTED_ENGINE_TIMEOUT_SECONDS=600

THERMAL_GUARD_ENABLED=false
START_TEMP_MAX_C=80
ABORT_TEMP_C=92
COOLDOWN_AFTER_ABORT_SECONDS=120
MIN_FREE_RAM_ABORT_MB=512
HW_SENSOR_URL=
HW_SENSOR_TIMEOUT_SECONDS=2
HW_SENSOR_INTERVAL_SECONDS=2

PLAN_FREE_MONTHLY_CREDITS=50
PLAN_PRO_MONTHLY_CREDITS=300
PLAN_FREE_DAILY_PROMPTS=3
PLAN_PRO_DAILY_PROMPTS=20
PLAN_FREE_UPSCALE_DAILY_LIMIT=5
PLAN_PRO_UPSCALE_DAILY_LIMIT=50
CREDIT_RESET_STARTUP_LIMIT=1000
ADMIN_EMAILS=

AVATAR_MAX_BYTES=5242880
AVATAR_SIZE_PX=256
AVATAR_MAX_PIXELS=1000000

C2PA_REQUIRED=false
C2PA_ALGORITHM=es256
PSEUDO_LOCALIZATION=false
