# ============================================================
# AImaginator — .env.example
# Copie para .env e preencha com valores reais.
# NUNCA coloque valores reais neste arquivo.
# ============================================================

# ---- Core ----
FEATURE_IMAGE_GENERATION_ENABLED=false
APP_ENV=development
APP_NAME=AImaginator
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_hex_chars
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
# Origens extras de CORS separadas por virgula (ex.: previews da Vercel).
# FRONTEND_BASE_URL e sempre incluida; este campo adiciona origens.
# Producao: https://aimaginator.vercel.app,https://seu-dominio.com
FRONTEND_ORIGINS=
# Aplica migrations pendentes (alembic upgrade head) no boot da API.
# Em producao mantenha `true` (default); em testes/CI defina `false`.
AUTO_MIGRATE=true

# ---- PostgreSQL ----
POSTGRES_USER=aimaginator
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aimaginator
DATABASE_URL=postgresql+asyncpg://aimaginator:CHANGE_ME@localhost:5432/aimaginator

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- RabbitMQ / Celery ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- Google OAuth 2.0 / OIDC (Google Cloud Console) ----
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
# Opcional: se vazio, deriva de API_BASE_URL (ex.: {API_BASE_URL}/api/v1/auth/google/callback).
# No Google Cloud Console, o "Authorized redirect URI" DEVE ser exatamente:
#   https://SEU-BACKEND/api/v1/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# ---- JWT ----
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# ---- Engine de imagem local ----
# "stub" (default, sem modelo) | "sdcpp" (FLUX/Kontext via sd-cli; exige
# todos os caminhos SDCPP_* e o storage S3 configurados).
IMAGE_ENGINE=stub
SDCPP_BINARY_PATH=
SDCPP_VAE_PATH=
SDCPP_CLIP_L_PATH=
SDCPP_T5XXL_PATH=
SDCPP_GEN_MODEL_PATH=
SDCPP_EDIT_MODEL_PATH=

# Parametros medidos no spike (Fase 1). Ajuste somente com medicao.
GEN_WIDTH=512
GEN_HEIGHT=512
GEN_STEPS=8
GEN_GUIDANCE=3.5
EDIT_WIDTH=512
EDIT_HEIGHT=512
EDIT_STEPS=8
EDIT_GUIDANCE=3.5
GENERATION_TIMEOUT_SECONDS=300
EDIT_TIMEOUT_SECONDS=600
# Guarda de RAM antes de iniciar o sd-cli (MB livres).
MIN_FREE_RAM_MB=6000
# Pausa apos cada job de imagem (segundos; 0 desativa).
COOLDOWN_SECONDS_BETWEEN_JOBS=0

# Upload de imagem para edicao.
EDIT_UPLOAD_MAX_BYTES=10485760
EDIT_UPLOAD_MAX_DIMENSION=8192
EDIT_UPLOAD_MAX_PIXELS=40000000

# ---- Assistente de prompts (LLM local OpenAI-compatible) ----
PROMPT_MAX_CHARS=1000
LLM_BASE_URL=http://localhost:1235/v1
# Recomendado em hardware de 4 GB VRAM (menos RAM e mais rapido):
# LLM_MODEL=qwen3.5-4b@q4_k_m
# Alternativa mais lenta/pesada:
# LLM_MODEL=qwen/qwen3.5-9b
LLM_API_KEY=lm-studio
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=512
LLM_MAX_OUTPUT_TOKENS_RETRY=1024
# "none" desliga o reasoning no LM Studio; vazio = nao envia o campo.
LLM_REASONING_EFFORT=none
LLM_TTL_SECONDS=60
# Descarrega o modelo via `lms unload --all` antes do FLUX (dev=true).
LLM_UNLOAD_AFTER_USE=false
LMS_CLI_PATH=
LLM_UNLOAD_TIMEOUT_SECONDS=20
# Conteudo do LLM em log SO em development e com opt-in.
LLM_DEBUG_LOG_CONTENT=false
LLM_BLOCK_CONFIDENCE=0.5
# Geracoes queued/processing sem heartbeat viram queue_lost.
QUEUE_STALE_SECONDS=900
# Em development, infra remota falha o boot salvo opt-in consciente.
ALLOW_REMOTE_INFRA_IN_DEV=false

# ---- Moderacao e penalidades (janela de 24h) ----
MODERATION_STORE_PROMPT_TEXT=false
MOD_WARN_AT=3
MOD_BLOCK_AT=5
MOD_BLOCK_MINUTES=60
MOD_REVIEW_AT=10
MOD_REVIEW_BLOCK_HOURS=24
MODERATION_WINDOW_HOURS=24

# ---- Provedor de IA de imagem (legado HTTP externo) ----
# Mantido para compatibilidade; o switch futuro e IMAGE_ENGINE.
AI_IMAGE_PROVIDER=stub
AI_IMAGE_API_KEY=CHANGE_ME
AI_IMAGE_API_BASE_URL=https://api.exemplo-provedor.com

# ---- Classificador de tópico (guardrail de escopo, Camada 1) ----
# "stub" (default, sem LLM) | "http" (OpenAI Chat Completions) | "gemini"
# (API nativa do Gemini).
# Para "gemini": use sua Google API Key (ex.: AIza... ou AQ....) e modelo
# "gemini-1.5-flash" ou "gemini-1.5-pro".
# NÃO use TOPIC_CLASSIFIER_API_BASE_URL com "gemini" (usa endpoint nativo do Google).
TOPIC_CLASSIFIER_PROVIDER=stub
TOPIC_CLASSIFIER_API_KEY=
TOPIC_CLASSIFIER_API_BASE_URL=https://api.exemplo-provedor.com/v1
TOPIC_CLASSIFIER_MODEL=gemini-1.5-flash
TOPIC_CLASSIFIER_TIMEOUT_SECONDS=4.0

# ---- Observabilidade ----
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
SENTRY_ENVIRONMENT=development
PROMETHEUS_MULTIPROC_DIR=.prometheus-multiproc
WORKER_METRICS_PORT=9100

# ---- Rate limiting / resiliência ----
RATE_LIMIT_GENERATION_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ---- SSRF protection ----
ALLOWED_IMAGE_URL_DOMAINS=images.unsplash.com

# ---- Storage ----
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_BUCKET_URL=https://cdn.exemplo.com

# S3/MinIO (obrigatorio quando IMAGE_ENGINE=sdcpp).
# Em AWS, S3_ACCESS_KEY/S3_SECRET_KEY podem vir de AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# e S3_ENDPOINT_URL pode ficar vazio (endpoint padrao da AWS).
# Em producao use um bucket privado; as imagens sao servidas por URL assinada.
S3_ENDPOINT_URL=
# Endpoint publico para URLs assinadas (ex.: http://localhost:9002 no compose).
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PRESIGN_EXPIRES_SECONDS=900
S3_SOURCE_RETENTION_HOURS=24

# ---- Frontend (SOMENTE valores públicos — NUNCA segredos aqui) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# URL publica do site (canonical/SEO/sitemap). Producao: https://aimaginator.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=

# ---- Moderacao de imagem (saida e origem de edicao) ----
IMAGE_MODERATION_ENABLED=true
# fake (testes/dev) | local (transformers/CLIP; grupo opcional "moderation")
IMAGE_MODERATOR=fake
IMAGE_NSFW_MODEL_PATH=
IMAGE_CLIP_MODEL_PATH=
IMAGE_NSFW_THRESHOLD=0.5
IMAGE_GORE_THRESHOLD=0.5
IMAGE_HATE_THRESHOLD=0.5
IMAGE_SELF_HARM_THRESHOLD=0.5

# ---- Marca d'agua (aplicada em TODAS as imagens servidas) ----
WATERMARK_LOGO_PATH=modules/image_generation/assets/AImaginator_pic_transparent.png
WATERMARK_WIDTH_RATIO=0.20
WATERMARK_MIN_WIDTH_PX=96
WATERMARK_MARGIN_RATIO=0.025
WATERMARK_OPACITY=0.9
WATERMARK_SHADOW=true

# ---- Metadados de IA / C2PA opcional ----
C2PA_ENABLED=false
C2PA_CERT_PATH=
C2PA_KEY_PATH=

# ---- Upscale ----
UPSCALE_ENGINE=lanczos
SDCPP_UPSCALE_MODEL_PATH=
UPSCALE_TIMEOUT_SECONDS=300
UPSCALE_DAILY_LIMIT=5

# Origem publica do storage para CSP do frontend
NEXT_PUBLIC_STORAGE_ORIGIN=http://localhost:9002

# ---- Plataforma (Fase 9) ----
WORKER_MODE=local
WORKER_CAPABILITIES=generate,edit,upscale
WORKER_HEARTBEAT_TTL_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
# Vazio = automatico (true para sdcpp/hosted, false para stub)
ENGINE_AVAILABILITY_REQUIRED=
MAINTENANCE_MODE=false
MAINTENANCE_REDIS_KEY=system:maintenance
IMAGE_ENGINE_FALLBACK=

HOSTED_ENGINE_BASE_URL=
HOSTED_ENGINE_API_KEY=
HOSTED_ENGINE_GENERATE_PATH=/generate
HOSTED_ENGINE_EDIT_PATH=/edit
HOSTED_ENGINE_POLL_INTERVAL_SECONDS=1
HOSTED_ENGINE_TIMEOUT_SECONDS=600

THERMAL_GUARD_ENABLED=false
START_TEMP_MAX_C=80
ABORT_TEMP_C=92
COOLDOWN_AFTER_ABORT_SECONDS=120
MIN_FREE_RAM_ABORT_MB=512
HW_SENSOR_URL=
HW_SENSOR_TIMEOUT_SECONDS=2
HW_SENSOR_INTERVAL_SECONDS=2

PLAN_FREE_MONTHLY_CREDITS=50
PLAN_PRO_MONTHLY_CREDITS=300
PLAN_FREE_DAILY_PROMPTS=3
PLAN_PRO_DAILY_PROMPTS=20
PLAN_FREE_UPSCALE_DAILY_LIMIT=5
PLAN_PRO_UPSCALE_DAILY_LIMIT=50
CREDIT_RESET_STARTUP_LIMIT=1000
ADMIN_EMAILS=

AVATAR_MAX_BYTES=5242880
AVATAR_SIZE_PX=256
AVATAR_MAX_PIXELS=1000000

C2PA_REQUIRED=false
C2PA_ALGORITHM=es256
PSEUDO_LOCALIZATION=false
