# ============================================================
# AImaginator — .env.example
# Copie para .env e preencha com valores reais.
# NUNCA coloque valores reais neste arquivo.
# ============================================================

# ---- Core ----
APP_ENV=development
APP_NAME=AImaginator
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_hex_chars
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_USER=aimaginator
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aimaginator
DATABASE_URL=postgresql+asyncpg://aimaginator:CHANGE_ME@localhost:5432/aimaginator

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- RabbitMQ / Celery ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- Google OAuth 2.0 / OIDC (Google Cloud Console) ----
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
# Opcional: se vazio, deriva de API_BASE_URL (ex.: {API_BASE_URL}/api/v1/auth/google/callback).
# No Google Cloud Console, o "Authorized redirect URI" DEVE ser exatamente:
#   https://SEU-BACKEND/api/v1/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# ---- JWT ----
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# ---- Provedor de IA de imagem ----
AI_IMAGE_PROVIDER=stub
AI_IMAGE_API_KEY=CHANGE_ME
AI_IMAGE_API_BASE_URL=https://api.exemplo-provedor.com

# ---- Observabilidade ----
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
SENTRY_ENVIRONMENT=development
PROMETHEUS_MULTIPROC_DIR=

# ---- Rate limiting / resiliência ----
RATE_LIMIT_GENERATION_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ---- SSRF protection ----
ALLOWED_IMAGE_URL_DOMAINS=images.unsplash.com

# ---- Storage ----
STORAGE_BUCKET_URL=https://cdn.exemplo.com

# ---- Frontend (SOMENTE valores públicos — NUNCA segredos aqui) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SENTRY_DSN=
